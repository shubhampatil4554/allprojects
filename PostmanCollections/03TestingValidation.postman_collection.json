    {
      "name": "TestIncludeStatusCodeAndCookies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//if you want to test for the status code being one of a set,include them all in an array and use oneOf\r",
              "pm.test(\"Successful post request\", ()=>{\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200,201]);\r",
              "});\r",
              "//check the status code text\r",
              "pm.test(\"Status code name has string\", ()=>{\r",
              "    pm.response.to.have.status(\"Created\");\r",
              "});\r",
              "//--------------------------------------------\r",
              "//Testing Cookies\r",
              "//--------------------------------------------\r",
              "//Test if a cookie is present in the response\r",
              "pm.test(\"Cookie 'language' is present or not\",()=>{\r",
              "    pm.expect(pm.cookies.has('language')).to.be.true;\r",
              "})\r",
              "//Test for particular cookie value\r",
              "pm.test(\"Cookie language has value 1\",()=>{\r",
              "    pm.expect(pm.cookies.get('language')).to.eql(\"en-gb\");\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
