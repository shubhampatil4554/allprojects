    {
      "name": "ValidatingJSONFieldsResponse",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Validating JSON Fields in response\r",
              "pm.test(\"Validating json values \",()=>{\r",
              "    const jsonData= pm.response.json();\r",
              "    pm.expect(jsonData.name).to.eql(\"Shubham\");\r",
              "    pm.expect(jsonData.id).to.eql(\"1\");\r",
              "    pm.expect(jsonData.phone).to.eql(\"1234567890\");\r",
              "    pm.expect(jsonData.courses[0]).to.eql(\"java\");\r",
              "    pm.expect(jsonData.courses[1]).to.eql(\"MySQL\");\r",
              "});"
            ],
            "type": "text/javascript",
